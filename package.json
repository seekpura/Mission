{
  "name": "mission-runtime",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema:compat": "node --experimental-strip-types scripts/check-schema-compat.ts",
    "verify": "npm run typecheck && npm run schema:compat && npm test",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/e2e/*.test.ts",
    "smoke": "node --experimental-strip-types tests/e2e/smoke.ts",
    "server": "node --experimental-strip-types src/server/main.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
